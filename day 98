#include <stdio.h>
#include <stdlib.h>

// Comparator to sort by start time
int compare(const void *a, const void *b) {
    int *x = (int *)a;
    int *y = (int *)b;
    return x[0] - y[0];
}

int main() {
    int n;

    printf("Enter number of intervals: ");
    scanf("%d", &n);

    int intervals[n][2];

    printf("Enter intervals (start end):\n");
    for (int i = 0; i < n; i++) {
        scanf("%d %d", &intervals[i][0], &intervals[i][1]);
    }

    // Step 1: Sort intervals
    qsort(intervals, n, sizeof(intervals[0]), compare);

    // Result array
    int result[n][2];
    int index = 0;

    // Initialize first interval
    result[index][0] = intervals[0][0];
    result[index][1] = intervals[0][1];

    // Step 2: Merge
    for (int i = 1; i < n; i++) {
        // Overlap condition
        if (intervals[i][0] <= result[index][1]) {
            // Merge
            if (intervals[i][1] > result[index][1])
                result[index][1] = intervals[i][1];
        } else {
            // New interval
            index++;
            result[index][0] = intervals[i][0];
            result[index][1] = intervals[i][1];
        }
    }

    // Output result
    printf("Merged intervals:\n");
    for (int i = 0; i <= index; i++) {
        printf("%d %d\n", result[i][0], result[i][1]);
    }

    return 0;
}
